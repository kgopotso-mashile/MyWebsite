  function initServices() {
    const main = $('main');
    if (!main) return;
    const sec = el('section', { id: 'nbk-finder' }, `
      <h2>Find Your Perfect Treatment</h2>
      <p>Search, filter and sort our services to find what suits you.</p>
      <div class="nbk-tabs" role="tablist" aria-label="Service category">
        <button class="nbk-tab" role="tab" data-cat="all" aria-selected="true">All</button>
        <button class="nbk-tab" role="tab" data-cat="women" aria-selected="false">Women</button>
        <button class="nbk-tab" role="tab" data-cat="men" aria-selected="false">Men</button>
      </div>
      <div class="nbk-toolbar">
        <input type="search" id="nbk-search" placeholder="Search services (e.g. gel, pedicure)…" aria-label="Search services">
        <select id="nbk-sort" aria-label="Sort services">
          <option value="default">Sort: Featured</option>
          <option value="low">Price: Low to High</option>
          <option value="high">Price: High to Low</option>
          <option value="az">Name: A to Z</option>
        </select>
      </div>
      <p class="nbk-meta" id="nbk-count" aria-live="polite"></p>
      <div class="nbk-grid" id="nbk-grid"></div>`);
    main.prepend(sec);
    const state = { cat: 'all', q: '', sort: 'default' };
    const grid = $('#nbk-grid'), countEl = $('#nbk-count');
    const highlight = text => {
      if (!state.q) return esc(text);
      const re = new RegExp('(' + state.q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'ig');
      return esc(text).replace(re, '<mark>$1</mark>');
    };
    function render() {
      let list = SERVICES.filter(s => (state.cat === 'all' || s.cat === state.cat || s.cat === 'both')
        && (s.name + ' ' + s.blurb).toLowerCase().includes(state.q.toLowerCase()));
      if (state.sort === 'low') list.sort((a, b) => a.price - b.price);
      if (state.sort === 'high') list.sort((a, b) => b.price - a.price);
      if (state.sort === 'az') list.sort((a, b) => a.name.localeCompare(b.name));
      countEl.textContent = list.length ? `Showing ${list.length} service${list.length > 1 ? 's' : ''}` : '';
      grid.innerHTML = list.length ? list.map((s, i) => `
        <article class="nbk-card" style="animation-delay:${i * 60}ms">
          <span class="nbk-tag">${s.cat === 'both' ? 'Everyone' : s.cat === 'men' ? 'Men' : 'Women'}</span>
          <h3>${highlight(s.name)}</h3>
          <p>${highlight(s.blurb)}</p>
          <p>⏱ about ${s.mins} min</p>
          <div class="nbk-price">from ${money(s.price)}</div>
          <button class="nbk-btn" data-id="${s.id}">View details</button>
        </article>`).join('')
        : '<p>No services match your search. Try a different word or category.</p>';
    }
    $$('.nbk-tab', sec).forEach(tab => tab.addEventListener('click', () => {
      $$('.nbk-tab', sec).forEach(t => t.setAttribute('aria-selected', String(t === tab)));
      state.cat = tab.dataset.cat; render();
    }));
    $('#nbk-search').addEventListener('input', e => { state.q = e.target.value.trim(); render(); });
    $('#nbk-sort').addEventListener('change', e => { state.sort = e.target.value; render(); });
    grid.addEventListener('click', e => {
      const btn = e.target.closest('button[data-id]');
      if (!btn) return;
      const s = SERVICES.find(x => x.id === btn.dataset.id);
      openModal(`<h2>${esc(s.name)}</h2><p>${esc(s.blurb)}</p><p><strong>From:</strong> ${money(s.price)}<br><strong>Time:</strong> about ${s.mins} minutes</p><div class="nbk-actions"><a class="nbk-btn" href="enquiry.html?service=${encodeURIComponent(s.id)}">Enquire</a><a class="nbk-btn nbk-ghost" href="tel:${CONFIG.phoneTel}">Call us</a></div>`);
    });
    render();
  }

  /* ===== NEW: GLOBAL SEARCH BAR (for home, about, contact, enquiry) ===== */
