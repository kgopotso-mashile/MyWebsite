  function openModal(html) {
    const bg = el('div', { class: 'nbk-modal-bg', role: 'dialog', 'aria-modal': 'true' });
    const box = el('div', { class: 'nbk-modal' }, `<button class="nbk-x" aria-label="Close">&times;</button>${html}`);
    bg.appendChild(box);
    document.body.appendChild(bg);
    const prevFocus = document.activeElement;
    const close = () => { bg.remove(); document.removeEventListener('keydown', onKey); prevFocus && prevFocus.focus && prevFocus.focus(); };
    const onKey = e => { if (e.key === 'Escape') close(); };
    document.addEventListener('keydown', onKey);
    bg.addEventListener('click', e => { if (e.target === bg) close(); });
    $('.nbk-x', box).addEventListener('click', close);
    const first = $('a,button:not(.nbk-x)', box);
    (first || $('.nbk-x', box)).focus();
    return { close, box };
  }

  function initSiteWide() {
    const here = location.pathname.split('/').pop() || 'index.html';
    $$('nav a').forEach(a => {
      const target = (a.getAttribute('href') || '').split('/').pop();
      if (target === here) { a.classList.add('nbk-active'); a.setAttribute('aria-current', 'page'); }
    });
    const bar = $('header') || $('body > nav');
    const topBtn = el('button', { id: 'nbk-top', 'aria-label': 'Back to top' }, '&uarr;');
    document.body.appendChild(topBtn);
    topBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' }));
    const onScroll = () => {
      bar && bar.classList.toggle('nbk-scrolled', window.scrollY > 10);
      topBtn.classList.toggle('show', window.scrollY > 400);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    const items = $$('main section, footer');
    if (!reduceMotion && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('nbk-in'); io.unobserve(e.target); } });
      }, { threshold: 0.08 });
      items.forEach(i => { i.classList.add('nbk-reveal'); io.observe(i); });
    }
  }

  function initLightbox() {
    const ov = el('div', { class: 'img-lightbox-overlay', role: 'dialog', 'aria-label': 'Image preview' });
    const big = el('img');
    const prev = el('button', { class: 'nbk-lb-nav nbk-lb-prev', 'aria-label': 'Previous image' }, '&#10094;');
    const next = el('button', { class: 'nbk-lb-nav nbk-lb-next', 'aria-label': 'Next image' }, '&#10095;');
    const count = el('div', { class: 'nbk-lb-count' });
    ov.append(big, prev, next, count);
    document.body.appendChild(ov);
    let group = [], idx = 0;
    const show = () => {
      const img = group[idx];
      big.src = img.currentSrc || img.src;
      big.alt = img.alt || '';
      const multi = group.length > 1;
      prev.style.display = next.style.display = count.style.display = multi ? '' : 'none';
      count.textContent = `${idx + 1} / ${group.length}`;
    };
    const open = img => {
      group = $$('main td img').includes(img) ? $$('main td img') : [img];
      idx = group.indexOf(img);
      show();
      ov.classList.add('active');
      document.body.style.overflow = 'hidden';
    };
    const close = () => { ov.classList.remove('active'); document.body.style.overflow = ''; };
    const step = d => { idx = (idx + d + group.length) % group.length; show(); };
    document.addEventListener('click', e => {
      const img = e.target.closest && e.target.closest('img');
      if (!img || ov.contains(img) || img.closest('.leaflet-container')) return;
      open(img);
    });
    prev.addEventListener('click', e => { e.stopPropagation(); step(-1); });
    next.addEventListener('click', e => { e.stopPropagation(); step(1); });
    ov.addEventListener('click', e => { if (e.target !== big) close(); });
    document.addEventListener('keydown', e => {
      if (!ov.classList.contains('active')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });
  }

  function isOpenNow() {
    const parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Africa/Johannesburg', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date());
    const mins = (+parts.find(p => p.type === 'hour').value % 24) * 60 + +parts.find(p => p.type === 'minute').value;
    return mins >= CONFIG.openMinutes && mins < CONFIG.closeMinutes;
  }
