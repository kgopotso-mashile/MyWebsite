  /* ------------------------------------------------------------------
     Services page: dynamic service finder (tabs + search + sort + modal)
     ------------------------------------------------------------------ */
  function initServices() {
    const main = $('main');
    if (!main) return;
    const sec = el('section', { id: 'nbk-finder' }, `
      <h2>Find Your Perfect Treatment</h2>
      <p>Search, filter and sort our services to find what suits you.</p>
      <div class="nbk-tabs" role="tablist" aria-label="Service category">
        <button class="nbk-tab" role="tab" data-cat="all" aria-selected="true">All</button>
        <button class="nbk-tab" role="tab" data-cat="women" aria-selected="false">Women</button>
        <button class="nbk-tab" role="tab" data-cat="men" aria-selected="false">Men</button>
      </div>
      <div class="nbk-toolbar">
        <input type="search" id="nbk-search" placeholder="Search services (e.g. gel, pedicure)…" aria-label="Search services">
        <select id="nbk-sort" aria-label="Sort services">
          <option value="default">Sort: Featured</option>
          <option value="low">Price: Low to High</option>
          <option value="high">Price: High to Low</option>
          <option value="az">Name: A to Z</option>
        </select>
      </div>
      <p class="nbk-meta" id="nbk-count" aria-live="polite"></p>
      <div class="nbk-grid" id="nbk-grid"></div>`);
    main.prepend(sec);

    const state = { cat: 'all', q: '', sort: 'default' };
    const grid = $('#nbk-grid'), countEl = $('#nbk-count');
    const highlight = text => {
      if (!state.q) return esc(text);
      const re = new RegExp('(' + state.q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'ig');
      return esc(text).replace(re, '<mark>$1</mark>');
    };

    function render() {
      let list = SERVICES.filter(s => (state.cat === 'all' || s.cat === state.cat || s.cat === 'both')
        && (s.name + ' ' + s.blurb).toLowerCase().includes(state.q.toLowerCase()));
      if (state.sort === 'low') list.sort((a, b) => a.price - b.price);
      if (state.sort === 'high') list.sort((a, b) => b.price - a.price);
      if (state.sort === 'az') list.sort((a, b) => a.name.localeCompare(b.name));
      countEl.textContent = list.length ? `Showing ${list.length} service${list.length > 1 ? 's' : ''}` : '';
      grid.innerHTML = list.length ? list.map((s, i) => `
        <article class="nbk-card" style="animation-delay:${i * 60}ms">
          <span class="nbk-tag">${s.cat === 'both' ? 'Everyone' : s.cat === 'men' ? 'Men' : 'Women'}</span>
          <h3>${highlight(s.name)}</h3>
          <p>${highlight(s.blurb)}</p>
          <p>⏱ about ${s.mins} min</p>
          <div class="nbk-price">from ${money(s.price)}</div>
          <button class="nbk-btn" data-id="${s.id}">View details</button>
        </article>`).join('')
        : '<p>No services match your search. Try a different word or category.</p>';
    }

    $$('.nbk-tab', sec).forEach(tab => tab.addEventListener('click', () => {
      $$('.nbk-tab', sec).forEach(t => t.setAttribute('aria-selected', String(t === tab)));
      state.cat = tab.dataset.cat; render();
    }));
    $('#nbk-search').addEventListener('input', e => { state.q = e.target.value.trim(); render(); });
    $('#nbk-sort').addEventListener('change', e => { state.sort = e.target.value; render(); });
    grid.addEventListener('click', e => {
      const btn = e.target.closest('button[data-id]');
      if (!btn) return;
      const s = SERVICES.find(x => x.id === btn.dataset.id);
      openModal(`
        <h2>${esc(s.name)}</h2>
        <p>${esc(s.blurb)}</p>
        <p><strong>From:</strong> ${money(s.price)}<br><strong>Time:</strong> about ${s.mins} minutes</p>
        <p class="nbk-note">Final price depends on length, design and extras.</p>
        <div class="nbk-actions">
          <a class="nbk-btn" href="enquiry.html?service=${encodeURIComponent(s.id)}">Enquire about this</a>
          <a class="nbk-btn nbk-ghost" href="tel:${CONFIG.phoneTel}">Call us</a>
        </div>`);
    });
    render();
  }

  /* ------------------------------------------------------------------
     Form engine: validation, error messages, AJAX submission
     ------------------------------------------------------------------ */
  async function submitAjax(payload) {
    // Without an endpoint the request is simulated so the page still behaves like AJAX.
    if (!CONFIG.formEndpoint) { await sleep(900); return { ok: true, simulated: true }; }
    const res = await fetch(CONFIG.formEndpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(payload)
    });
    if (!res.ok) throw new Error('Request failed: ' + res.status);
    return res.json().catch(() => ({ ok: true }));
  }

  function enhanceForm(form, onValid) {
    form.noValidate = true; // we show our own, friendlier messages
    const fields = () => $$('input,select,textarea', form)
      .filter(c => !['submit', 'button', 'reset', 'hidden', 'image'].includes(c.type));
    const keyOf = c => `${c.name} ${c.id} ${c.placeholder || ''}`.toLowerCase();

    const labelOf = c => {
      const l = (c.id && $(`label[for="${c.id}"]`, form)) || c.closest('label');
      const txt = l ? l.textContent : (c.getAttribute('aria-label') || c.placeholder || c.name || 'Field');
      return txt.replace(/[*:]/g, '').replace(/\s+/g, ' ').trim();
    };

    function validateField(c) {
      const v = c.value.trim();
      const key = keyOf(c);
      const optional = /optional/.test(key) || c.hasAttribute('data-optional');

      if (c.type === 'checkbox') return c.required && !c.checked ? 'Please tick this box to continue.' : '';
      if (c.type === 'radio') {
        const group = $$(`input[type=radio][name="${c.name}"]`, form);
        return group.some(r => r.checked) || optional ? '' : 'Please choose one option.';
      }
      if (c.tagName === 'SELECT') {
        const first = c.options[0];
        const placeholder = c.selectedIndex === 0 && first && /select|choose|--/i.test(first.text);
        return (v === '' || placeholder) && !optional ? 'Please choose an option.' : '';
      }
      if (c.type === 'file') {
        const f = c.files && c.files[0];
        if (!f) return c.required ? 'Please attach a file.' : '';
        if (!f.type.startsWith('image/')) return 'Please attach an image (JPG, PNG, etc.).';
        return f.size > 5 * 1024 * 1024 ? 'Image is too large – maximum 5 MB.' : '';
      }
      if (!v) return optional ? '' : 'This field is required.';

      if (c.type === 'email' || /email/.test(key))
        return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v) ? '' : 'Please enter a valid email address (e.g. name@example.com).';

      if (c.type === 'tel' || /phone|cell|mobile|\btel/.test(key)) {
        const digits = v.replace(/[\s\-()]/g, '');
        return /^(\+27|0)[1-9]\d{8}$/.test(digits) ? '' : 'Enter a valid South African number (e.g. 066 422 4639 or +27 66 422 4639).';
      }

      if (c.type === 'date') {
        const d = new Date(v + 'T00:00:00'), today = new Date(); today.setHours(0, 0, 0, 0);
        if (isNaN(d)) return 'Please choose a valid date.';
        if (d < today) return 'Please choose today or a future date.';
        const max = new Date(today); max.setFullYear(max.getFullYear() + 1);
        return d > max ? 'Please choose a date within the next year.' : '';
      }

      if (c.type === 'time') {
        const [h, m] = v.split(':').map(Number), mins = h * 60 + m;
        return mins >= CONFIG.openMinutes && mins <= CONFIG.closeMinutes ? '' : 'We are open between 08:00 and 19:30.';
      }

      if (c.tagName === 'TEXTAREA') {
        if (v.length < 10) return 'Please write at least 10 characters.';
        if (v.length > 500) return 'Please keep your message under 500 characters.';
        return '';
      }

      if (c.type === 'number') return c.checkValidity() ? '' : (c.validationMessage || 'Please enter a valid number.');

      if (/name/.test(key))
        return /^[A-Za-zÀ-ÿ][A-Za-zÀ-ÿ' -]{1,49}$/.test(v) ? '' : 'Use letters only (2–50 characters).';

      if (v.length < 3) return 'Please enter at least 3 characters.';
      if (c.maxLength > 0 && v.length > c.maxLength) return `Maximum ${c.maxLength} characters.`;
      return '';
    }

    function setError(c, msg) {
      const group = c.type === 'radio' ? $$(`input[type=radio][name="${c.name}"]`, form) : [c];
      const anchor = group[group.length - 1];
      let box = anchor._nbkErr;
      if (!box) {
        box = el('div', { class: 'nbk-error', id: 'err-' + Math.random().toString(36).slice(2, 8) });
        anchor.insertAdjacentElement('afterend', box);
        anchor._nbkErr = box;
      }
      box.textContent = msg;
      group.forEach(g => {
        g.classList.toggle('nbk-invalid', !!msg);
        g.classList.toggle('nbk-valid', !msg && !!(g.value || g.checked));
        g.setAttribute('aria-invalid', msg ? 'true' : 'false');
        if (msg) g.setAttribute('aria-describedby', box.id); else g.removeAttribute('aria-describedby');
      });
    }

    // live feedback
    fields().forEach(c => {
      const check = () => setError(c, validateField(c));
      c.addEventListener('blur', check);
      const instant = c.tagName === 'SELECT' || ['checkbox', 'radio', 'file', 'date'].includes(c.type);
      c.addEventListener(instant ? 'change' : 'input', () => { if (c.classList.contains('nbk-invalid') || instant) check(); });
      if (c.tagName === 'TEXTAREA') {
        c.maxLength = 500;
        const counter = el('small', { class: 'nbk-char' }, '0 / 500');
        c.insertAdjacentElement('afterend', counter);
        c.addEventListener('input', () => { counter.textContent = `${c.value.length} / 500`; });
      }
    });

    function collect() {
      const seen = new Set(), rows = [];
      fields().forEach(c => {
        if (c.type === 'radio') {
          if (seen.has(c.name)) return; seen.add(c.name);
          const picked = $(`input[type=radio][name="${c.name}"]:checked`, form);
          if (picked) rows.push({ label: labelOf(picked.closest('fieldset') || picked), key: keyOf(c), value: picked.value, ctrl: c });
          return;
        }
        let value = c.value.trim();
        if (c.tagName === 'SELECT') value = c.options[c.selectedIndex] ? c.options[c.selectedIndex].text.trim() : '';
        if (c.type === 'checkbox') value = c.checked ? 'Yes' : 'No';
        if (c.type === 'file') value = c.files && c.files[0] ? c.files[0].name : '';
        if (value) rows.push({ label: labelOf(c), key: keyOf(c), value, ctrl: c });
      });
      return rows;
    }

    form.addEventListener('submit', async e => {
      e.preventDefault();
      let firstBad = null;
      fields().forEach(c => { const m = validateField(c); setError(c, m); if (m && !firstBad) firstBad = c; });
      if (firstBad) {
        firstBad.focus();
        form.classList.add('nbk-shake');
        setTimeout(() => form.classList.remove('nbk-shake'), 500);
        return;
      }
      const btn = $('[type=submit]', form);
      const original = btn ? (btn.tagName === 'INPUT' ? btn.value : btn.innerHTML) : '';
      const setBtn = t => { if (!btn) return; btn.tagName === 'INPUT' ? (btn.value = t) : (btn.textContent = t); };
      if (btn) { btn.disabled = true; setBtn('Sending…'); }
      try {
        await onValid(collect());
      } catch (err) {
        console.error(err);
        let msg = $('.nbk-form-error', form);
        if (!msg) { msg = el('div', { class: 'nbk-error nbk-form-error', role: 'alert' }); form.appendChild(msg); }
        msg.textContent = `Sorry, something went wrong. Please try again or call us on ${CONFIG.phoneDisplay}.`;
      } finally {
        if (btn) { btn.disabled = false; btn.tagName === 'INPUT' ? (btn.value = original) : (btn.innerHTML = original); }
      }
    });

    form.addEventListener('reset', () => {
      fields().forEach(c => { c.classList.remove('nbk-invalid', 'nbk-valid'); c.removeAttribute('aria-invalid'); if (c._nbkErr) c._nbkErr.textContent = ''; });
    });

    return { fields };
  }

  function showResult(form, html) {
    form._nbkCard && form._nbkCard.remove();
    const card = el('div', { class: 'nbk-result', role: 'status', tabindex: '-1' }, html);
    form.insertAdjacentElement('afterend', card);
    form._nbkCard = card;
    form.hidden = true;
    card.focus();
    card.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
    const again = $('[data-again]', card);
    again && again.addEventListener('click', () => { card.remove(); form.reset(); form.hidden = false; $('input,select,textarea', form)?.focus(); });
  }

  const firstName = rows => {
    const r = rows.find(x => /name/.test(x.key) && !/user|sur/.test(x.key)) || rows.find(x => /name/.test(x.key));
    return r ? r.value.split(' ')[0] : 'there';
  };

  function findService(text, exactOnly = false) {
    const t = text.toLowerCase();
    const exact = [...SERVICES].sort((a, b) => b.name.length - a.name.length).find(s => t.includes(s.name.toLowerCase()) || t === s.id);
    return exact || (exactOnly ? undefined : SERVICES.find(s => s.kw.some(k => t.includes(k))));
  }

  /* ------------------------------------------------------------------
     Enquiry page
     ------------------------------------------------------------------ */
  function initEnquiry() {
    $$('form').forEach(form => {
      enhanceForm(form, async rows => {
        await submitAjax({ form: 'enquiry', fields: rows.map(r => ({ label: r.label, value: r.value })) });

        const service = rows.map(r => findService(r.value, true)).find(Boolean) || rows.map(r => findService(r.value)).find(Boolean);
        const dateRow = rows.find(r => r.ctrl.type === 'date');
        const shapeRow = rows.find(r => /square|stil|almond|coffin/i.test(r.value));
        let availability = 'We are open Monday to Sunday, 08:00–19:30.';
        if (dateRow) {
          const d = new Date(dateRow.value + 'T00:00:00');
          const nice = d.toLocaleDateString('en-ZA', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
          availability = `We have openings on ${nice} between 08:00 and 19:30. We will confirm your exact time by phone.`;
        }
        showResult(form, `
          <h2>Thank you, ${esc(firstName(rows))}! 💅</h2>
          <p>We have received your enquiry. Here is what we can tell you so far:</p>
          <dl>
            ${service ? `<dt>Service</dt><dd>${esc(service.name)}</dd>
            <dt>Estimated cost</dt><dd>from ${money(service.price)}</dd>
            <dt>Estimated time</dt><dd>about ${service.mins} minutes</dd>` : `<dt>Cost</dt><dd>Our student-friendly prices range from R130 to R300. We will send you an exact quote.</dd>`}
            ${shapeRow ? `<dt>Nail shape</dt><dd>${esc(shapeRow.value)}</dd>` : ''}
            <dt>Availability</dt><dd>${esc(availability)}</dd>
          </dl>
          <p class="nbk-note">Prices are estimates; the final cost depends on length, design and extras.</p>
          <div class="nbk-actions">
            <a class="nbk-btn" href="tel:${CONFIG.phoneTel}">Call ${esc(CONFIG.phoneDisplay)}</a>
            <button class="nbk-btn nbk-ghost" type="button" data-again>Make another enquiry</button>
          </div>`);
      });

      // live price hint under each dropdown that matches a service
      $$('select', form).forEach(sel => {
        const hint = el('div', { class: 'nbk-hint' });
        sel._nbkErr ? sel._nbkErr.after(hint) : sel.insertAdjacentElement('afterend', hint);
        sel.addEventListener('change', () => {
          const s = findService(sel.options[sel.selectedIndex].text);
          hint.textContent = s ? `Estimated from ${money(s.price)} · about ${s.mins} min` : '';
        });
      });

      // pre-select service when arriving from the Services page (?service=gel-pedicure)
      const want = new URLSearchParams(location.search).get('service');
      const target = SERVICES.find(s => s.id === want);
      if (target) {
        for (const sel of $$('select', form)) {
          const i = [...sel.options].findIndex(o => findService(o.text, true) === target);
          if (i > -1) { sel.selectedIndex = i; sel.dispatchEvent(new Event('change')); break; }
        }
      }
    });
  }

  /* ------------------------------------------------------------------
     Contact page: validated form -> email, plus interactive map
     ------------------------------------------------------------------ */
  function initContact() {
    const form = $('form');
    if (form) {
      enhanceForm(form, async rows => {
        await submitAjax({ form: 'contact', to: CONFIG.recipientEmail, fields: rows.map(r => ({ label: r.label, value: r.value })) });

        const subjectRow = rows.find(r => /subject|type|reason/.test(r.key));
        const subject = `${CONFIG.businessName} website message${subjectRow ? ' – ' + subjectRow.value : ''}`;
        const body = rows.map(r => `${r.label}: ${r.value}`).join('\n');
        const mailto = `mailto:${CONFIG.recipientEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

        showResult(form, `
          <h2>Thanks, ${esc(firstName(rows))}!</h2>
          <p>Your message is ready to go. Click below to send it to <strong>${esc(CONFIG.recipientEmail)}</strong> from your email app.</p>
          <dl>${rows.map(r => `<dt>${esc(r.label)}</dt><dd>${esc(r.value)}</dd>`).join('')}</dl>
          <div class="nbk-actions">
            <a class="nbk-btn" href="${mailto}">Send email</a>
            <button class="nbk-btn nbk-ghost" type="button" data-again>Write another message</button>
          </div>`);
      });
    }
    initMap(form ? form.closest('section') : null);
  }

  function loadLeaflet() {
    return new Promise((resolve, reject) => {
      if (window.L) return resolve();
      const base = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/';
      const css = el('link', { rel: 'stylesheet', href: base + 'leaflet.min.css' });
      document.head.appendChild(css);
      const js = el('script', { src: base + 'leaflet.min.js' });
      js.onload = () => { window.L.Icon.Default.imagePath = base + 'images/'; resolve(); };
      js.onerror = reject;
      document.head.appendChild(js);
    });
  }

  async function initMap(afterSection) {
    const main = $('main');
    if (!main) return;
    const sec = el('section', { id: 'nbk-map-section' }, `
      <h2>Find Us</h2>
      <p>📍 ${esc(CONFIG.address)}<br>Open Monday to Sunday, 08:00–19:30.</p>
      <div id="nbk-map" aria-label="Map showing the salon location"></div>
      <p><a class="nbk-btn nbk-ghost" target="_blank" rel="noopener noreferrer" href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(CONFIG.address)}">Get directions</a></p>`);
    afterSection ? afterSection.after(sec) : main.appendChild(sec);
    try {
      await loadLeaflet();
      let { lat, lng, zoom } = CONFIG.map;
      // look up the exact position of the address (free OpenStreetMap geocoder)
      try {
        const q = encodeURIComponent(CONFIG.address);
        const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&countrycodes=za&q=${q}`, { headers: { Accept: 'application/json' } });
        const hit = (await res.json())[0];
        if (hit) { lat = +hit.lat; lng = +hit.lon; }
      } catch (e) { /* keep fallback coordinates */ }
      const map = L.map('nbk-map', { scrollWheelZoom: false }).setView([lat, lng], zoom);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19, attribution: '&copy; OpenStreetMap contributors'
      }).addTo(map);
      L.marker([lat, lng]).addTo(map)
        .bindPopup(`<strong>${CONFIG.businessName}</strong><br>${esc(CONFIG.street)}<br>${CONFIG.phoneDisplay}<br>Mon–Sun, 08:00–19:30`)
        .openPopup();
      map.once('focus', () => map.scrollWheelZoom.enable()); // zoom with scroll only after clicking the map
    } catch (err) {
      $('#nbk-map').innerHTML = '<p style="padding:1rem">The map could not be loaded. Please check your internet connection.</p>';
    }
  }

  /* ------------------------------------------------------------------
     SEO: structured data (LocalBusiness) added to <head>
     ------------------------------------------------------------------ */
  function injectStructuredData() {
    const data = {
      '@context': 'https://schema.org',
      '@type': 'NailSalon',
      name: CONFIG.businessName,
      telephone: CONFIG.phoneTel,
      address: {
        '@type': 'PostalAddress',
        streetAddress: CONFIG.street,
        addressLocality: 'Gqeberha',
        addressRegion: 'Eastern Cape',
        addressCountry: 'ZA'
      },
      image: new URL($('nav img')?.getAttribute('src') || '', location.href).href,
      url: location.origin + location.pathname.replace(/pages\/.*$/, ''),
      openingHoursSpecification: [{
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
        opens: '08:00', closes: '19:30'
      }],
      geo: { '@type': 'GeoCoordinates', latitude: CONFIG.map.lat, longitude: CONFIG.map.lng }
    };
    const s = el('script', { type: 'application/ld+json' });
    s.textContent = JSON.stringify(data);
    document.head.appendChild(s);
  }

  /* ------------------------------------------------------------------
     Start
     ------------------------------------------------------------------ */
  function init() {
    injectStyles();
    injectStructuredData();
    initSiteWide();
    initLightbox();
    if (PAGE === 'home') initHome();
    if (PAGE === 'services') initServices();
    if (PAGE === 'enquiry') initEnquiry();
    if (PAGE === 'contact') initContact();
    if (PAGE !== 'home' && PAGE !== 'services') initAccordion();
  }

  document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', init) : init();
})();
 