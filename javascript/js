  /* ===== NEW: CHATBOT WITH SEARCH INTEGRATED ===== */
  function initChatbot(){
    const bubble = el('button', { id: 'nbk-chat-bubble', 'aria-label':'Open chat' }, '💅');
    const win = el('div', { id: 'nbk-chat-window', class:'hidden' }, `
      <div id="nbk-chat-header"><span>NAILEDBYKOKETSO Assistant</span><button id="nbk-chat-close" style="background:none;border:0;color:#fff;font-size:1.4rem;cursor:pointer">×</button></div>
      <div id="nbk-chat-messages"></div>
      <div id="nbk-chat-input"><input id="nbk-chat-text" type="text" placeholder="Ask about prices, bookings..."><button id="nbk-chat-send">Send</button></div>
    `);
    document.body.append(bubble, win);
    const msgs = $('#nbk-chat-messages');
    const input = $('#nbk-chat-text');
    const sendBtn = $('#nbk-chat-send');
    
    function addMsg(t, who){
      const d = el('div', { class:`nbk-msg ${who}` }, esc(t));
      msgs.appendChild(d);
      msgs.scrollTop = msgs.scrollHeight;
    }
    function botReply(q){
      q = q.toLowerCase();
      if(!q) return "Hi! Ask me about gel, acrylic, pedicure, prices or hours 💅";
      const found = SERVICES.filter(s => q.includes(s.name.split(' ')[0].toLowerCase()) || s.name.toLowerCase().includes(q) || s.kw.some(k=>q.includes(k)) || q.includes(s.id));
      if(found.length) return `Found: ${found.map(s=>`${s.name} from ${money(s.price)} (${s.mins}min)`).join(', ')}. Want to book? Go to Enquiry page.`;
      if(q.includes('price')||q.includes('cost')||q.includes('how much')) return `Prices: ${SERVICES.map(s=>`${s.name} ${money(s.price)}`).join(', ')}. R130-R300 range.`;
      if(q.includes('open')||q.includes('hour')) return `We are open Mon-Sun 08:00-19:30. ${isOpenNow()?'We are OPEN now!':'We are closed now.'}`;
      if(q.includes('where')||q.includes('location')||q.includes('address')) return `We are at ${CONFIG.address}`;
      if(q.includes('book')||q.includes('enquir')) return `To book, go to Enquiry page or call ${CONFIG.phoneDisplay}`;
      if(q.includes('men')) return `For men we have Buff and Shine, Pedicure, Soak Off from R130.`;
      return `I can help with prices, bookings, hours, location. Try "gel price" or "acrylic time"`;
    }

    bubble.addEventListener('click', ()=>{ win.classList.toggle('hidden'); if(!win.classList.contains('hidden') && msgs.childElementCount===0) addMsg("Hey! I'm your nail assistant 💅 Ask me about prices or search for a service!", 'bot'); });
    $('#nbk-chat-close').addEventListener('click', ()=> win.classList.add('hidden'));
    function send(){
      const t = input.value.trim();
      if(!t) return;
      addMsg(t,'user');
      input.value='';
      setTimeout(()=> addMsg(botReply(t),'bot'), 400);
    }
    sendBtn.addEventListener('click', send);
    input.addEventListener('keypress', e=>{ if(e.key==='Enter') send(); });
  }

  function enhanceForm(form, onValid) {
    form.noValidate = true;
    const fields = () => $$('input,select,textarea', form).filter(c => !['submit', 'button', 'reset', 'hidden', 'image'].includes(c.type));
    const keyOf = c => `${c.name} ${c.id} ${c.placeholder || ''}`.toLowerCase();
    const labelOf = c => {
      const l = (c.id && $(`label[for="${c.id}"]`, form)) || c.closest('label');
      const txt = l ? l.textContent : (c.getAttribute('aria-label') || c.placeholder || c.name || 'Field');
      return txt.replace(/[*:]/g, '').replace(/\s+/g, ' ').trim();
    };
    function validateField(c) {
      const v = c.value.trim();
      const key = keyOf(c);
      const optional = /optional/.test(key) || c.hasAttribute('data-optional');
      if (c.type === 'checkbox') return c.required && !c.checked ? 'Please tick this box to continue.' : '';
      if (c.type === 'radio') {
        const group = $$(`input[type=radio][name="${c.name}"]`, form);
        return group.some(r => r.checked) || optional ? '' : 'Please choose one option.';
      }
      if (c.tagName === 'SELECT') {
        const first = c.options[0];
        const placeholder = c.selectedIndex === 0 && first && /select|choose|--/i.test(first.text);
        return (v === '' || placeholder) && !optional ? 'Please choose an option.' : '';
      }
      if (c.type === 'file') {
        const f = c.files && c.files[0];
        if (!f) return c.required ? 'Please attach a file.' : '';
        if (!f.type.startsWith('image/')) return 'Please attach an image.';
        return f.size > 5 * 1024 * 1024 ? 'Image is too large – max 5 MB.' : '';
      }
      if (!v) return optional ? '' : 'This field is required.';
      if (c.type === 'email' || /email/.test(key)) return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v) ? '' : 'Please enter a valid email.';
      if (c.type === 'tel' || /phone|cell|mobile|\btel/.test(key)) {
        const digits = v.replace(/[\s\-()]/g, '');
        return /^(\+27|0)[1-9]\d{8}$/.test(digits) ? '' : 'Enter a valid SA number.';
      }
      if (c.type === 'date') {
        const d = new Date(v + 'T00:00:00'), today = new Date(); today.setHours(0, 0, 0, 0);
        if (isNaN(d)) return 'Please choose a valid date.';
        if (d < today) return 'Please choose today or future.';
        const max = new Date(today); max.setFullYear(max.getFullYear() + 1);
        return d > max ? 'Choose within next year.' : '';
      }
      if (c.type === 'time') {
        const [h, m] = v.split(':').map(Number), mins = h * 60 + m;
        return mins >= CONFIG.openMinutes && mins <= CONFIG.closeMinutes ? '' : 'We are open 08:00-19:30.';
      }
      if (c.tagName === 'TEXTAREA') {
        if (v.length < 10) return 'At least 10 chars.';
        if (v.length > 500) return 'Under 500 chars.';
        return '';
      }
      return '';
    }
    function setError(c, msg) {
      const group = c.type === 'radio' ? $$(`input[type=radio][name="${c.name}"]`, form) : [c];
      const anchor = group[group.length - 1];
      let box = anchor._nbkErr;
      if (!box) { box = el('div', { class: 'nbk-error', id: 'err-' + Math.random().toString(36).slice(2, 8) }); anchor.insertAdjacentElement('afterend', box); anchor._nbkErr = box; }
      box.textContent = msg;
      group.forEach(g => {
        g.classList.toggle('nbk-invalid', !!msg);
        g.classList.toggle('nbk-valid', !msg && !!(g.value || g.checked));
        g.setAttribute('aria-invalid', msg ? 'true' : 'false');
      });
    }
    fields().forEach(c => {
      const check = () => setError(c, validateField(c));
      c.addEventListener('blur', check);
      const instant = c.tagName === 'SELECT' || ['checkbox', 'radio', 'file', 'date'].includes(c.type);
      c.addEventListener(instant ? 'change' : 'input', () => { if (c.classList.contains('nbk-invalid') || instant) check(); });
    });
    form.addEventListener('submit', async e => {
      e.preventDefault();
      let firstBad = null;
      fields().forEach(c => { const m = validateField(c); setError(c, m); if (m && !firstBad) firstBad = c; });
      if (firstBad) { firstBad.focus(); form.classList.add('nbk-shake'); setTimeout(() => form.classList.remove('nbk-shake'), 500); return; }
      const btn = $('[type=submit]', form);
      const original = btn ? (btn.tagName === 'INPUT' ? btn.value : btn.innerHTML) : '';
      const setBtn = t => { if (!btn) return; btn.tagName === 'INPUT' ? (btn.value = t) : (btn.textContent = t); };
      if (btn) { btn.disabled = true; setBtn('Sending…'); }
      try { await onValid(collect()); } catch (err) { console.error(err); } finally { if (btn) { btn.disabled = false; btn.tagName === 'INPUT' ? (btn.value = original) : (btn.innerHTML = original); } }
    });
    function collect() {
      const seen = new Set(), rows = [];
      fields().forEach(c => {
        if (c.type === 'radio') { if (seen.has(c.name)) return; seen.add(c.name); const picked = $(`input[type=radio][name="${c.name}"]:checked`, form); if (picked) rows.push({ label: labelOf(picked.closest('fieldset') || picked), key: keyOf(c), value: picked.value, ctrl: c }); return; }
        let value = c.value.trim();
        if (c.tagName === 'SELECT') value = c.options[c.selectedIndex] ? c.options[c.selectedIndex].text.trim() : '';
        if (c.type === 'checkbox') value = c.checked ? 'Yes' : 'No';
        if (c.type === 'file') value = c.files && c.files[0] ? c.files[0].name : '';
        if (value) rows.push({ label: labelOf(c), key: keyOf(c), value, ctrl: c });
      });
      return rows;
    }
    return { fields, collect };
  }

  function showResult(form, html) {
    form._nbkCard && form._nbkCard.remove();
    const card = el('div', { class: 'nbk-result', role: 'status', tabindex: '-1' }, html);
    form.insertAdjacentElement('afterend', card);
    form._nbkCard = card;
    form.hidden = true;
    card.focus();
    card.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
    const again = $('[data-again]', card);
    again && again.addEventListener('click', () => { card.remove(); form.reset(); form.hidden = false; $('input,select,textarea', form)?.focus(); });
  }

  const firstName = rows => {
    const r = rows.find(x => /name/.test(x.key) && !/user|sur/.test(x.key)) || rows.find(x => /name/.test(x.key));
    return r ? r.value.split(' ')[0] : 'there';
  };
  function findService(text, exactOnly = false) {
    const t = text.toLowerCase();
    const exact = [...SERVICES].sort((a, b) => b.name.length - a.name.length).find(s => t.includes(s.name.toLowerCase()) || t === s.id);
    return exact || (exactOnly ? undefined : SERVICES.find(s => s.kw.some(k => t.includes(k))));
  }

  function initEnquiry() {
    $$('form').forEach(form => {
      const { collect } = enhanceForm(form, async rows => {
        const service = rows.map(r => findService(r.value, true)).find(Boolean) || rows.map(r => findService(r.value)).find(Boolean);
        const dateRow = rows.find(r => r.ctrl.type === 'date');
        let availability = 'We are open Monday to Sunday, 08:00–19:30.';
        if (dateRow) {
          const d = new Date(dateRow.value + 'T00:00:00');
          const nice = d.toLocaleDateString('en-ZA', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
          availability = `We have openings on ${nice} between 08:00 and 19:30.`;
        }
        showResult(form, `<h2>Thank you, ${esc(firstName(rows))}! 💅</h2><dl>${service ? `<dt>Service</dt><dd>${esc(service.name)}</dd><dt>Estimated cost</dt><dd>from ${money(service.price)}</dd>` : `<dt>Cost</dt><dd>R130 to R300</dd>`}<dt>Availability</dt><dd>${esc(availability)}</dd></dl><div class="nbk-actions"><a class="nbk-btn" href="tel:${CONFIG.phoneTel}">Call ${esc(CONFIG.phoneDisplay)}</a><button class="nbk-btn nbk-ghost" type="button" data-again>Make another enquiry</button></div>`);
      });
    });
  }

  function initContact() {
    const form = $('form');
    if (form) {
      enhanceForm(form, async rows => {
        const subjectRow = rows.find(r => /subject|type|reason/.test(r.key));
        const subject = `${CONFIG.businessName} message${subjectRow ? ' – ' + subjectRow.value : ''}`;
        const body = rows.map(r => `${r.label}: ${r.value}`).join('\n');
        const mailto = `mailto:${CONFIG.recipientEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        showResult(form, `<h2>Thanks, ${esc(firstName(rows))}!</h2><dl>${rows.map(r => `<dt>${esc(r.label)}</dt><dd>${esc(r.value)}</dd>`).join('')}</dl><div class="nbk-actions"><a class="nbk-btn" href="${mailto}">Send email</a><button class="nbk-btn nbk-ghost" type="button" data-again>Write another message</button></div>`);
      });
    }
  }

  function init() {
    injectStyles();
    initSiteWide();
    initLightbox();
    initGlobalSearch();
    initChatbot();
    if (PAGE === 'home') initHome();
    if (PAGE === 'services') initServices();
    if (PAGE === 'enquiry') initEnquiry();
    if (PAGE === 'contact') initContact();
    if (PAGE !== 'home' && PAGE !== 'services') initAccordion();
  }
  document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', init) : init();
